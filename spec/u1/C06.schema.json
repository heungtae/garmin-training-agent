{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gta:contract:C06:1.0.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "approvalId": {
      "$ref": "urn:gta:contract:common:1.0.0#/$defs/Id"
    },
    "claimedSubjectRef": {
      "$ref": "urn:gta:contract:common:1.0.0#/$defs/Id"
    },
    "documentKind": {
      "enum": [
        "PLAN",
        "DISPOSITION"
      ]
    },
    "targetDigest": {
      "$ref": "urn:gta:contract:common:1.0.0#/$defs/Digest"
    },
    "policyDigest": {
      "$ref": "urn:gta:contract:common:1.0.0#/$defs/Digest"
    },
    "authorizedActions": {
      "type": "array",
      "items": {
        "enum": [
          "PUBLISH_PLAN",
          "REPLACE_PLAN",
          "WITHDRAW_PLAN",
          "CANCEL_PUBLICATION"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "declaredAt": {
      "$ref": "urn:gta:contract:common:1.0.0#/$defs/Timestamp"
    },
    "evidenceLocator": {
      "type": "object",
      "properties": {
        "profileId": {
          "$ref": "urn:gta:contract:common:1.0.0#/$defs/Id"
        },
        "recordId": {
          "$ref": "urn:gta:contract:common:1.0.0#/$defs/Id"
        },
        "sourceArtifact": {
          "$ref": "urn:gta:contract:common:1.0.0#/$defs/ArtifactRef"
        }
      },
      "required": [
        "profileId",
        "recordId",
        "sourceArtifact"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "urn:gta:contract:common:1.0.0#/$defs/Extensions"
    }
  },
  "required": [
    "schemaVersion",
    "approvalId",
    "claimedSubjectRef",
    "documentKind",
    "targetDigest",
    "policyDigest",
    "authorizedActions",
    "declaredAt",
    "evidenceLocator"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "documentKind": {
            "const": "PLAN"
          }
        }
      },
      "then": {
        "properties": {
          "authorizedActions": {
            "items": {
              "const": "PUBLISH_PLAN"
            }
          }
        }
      },
      "else": {
        "properties": {
          "authorizedActions": {
            "items": {
              "enum": [
                "REPLACE_PLAN",
                "WITHDRAW_PLAN",
                "CANCEL_PUBLICATION"
              ]
            }
          }
        }
      }
    }
  ]
}
